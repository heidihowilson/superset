<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Window-per-workspace/project/settings (PRD §7.1) opens secondary scenes via
	     openWindow(id:value:). UIKit refuses every openWindow call unless the app
	     declares multi-scene support, so this flag is load-bearing for the whole
	     multi-window core loop — not optional. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>NSFaceIDUsageDescription</key>
	<string>Superset uses Optic ID to unlock your workspaces and protect your host access credential.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Superset uses the microphone for voice dictation so you can speak prompts to your agent.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Superset uses speech recognition to turn your dictated prompts into editable text before you send them.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>sh.superset.visionos.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>superset</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
